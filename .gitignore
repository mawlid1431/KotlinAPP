# Gradle / Android Studio
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class

# Output APKs
apk/app-release.apk

# ...except the one the landing page serves from its Download button.
# Vercel builds from this repo, so if this file is ignored the download 404s.
!landingPage/public/*.apk

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
*.swp
*.swo
*.mcp.json
*.mcp.json/
*.env/
*.env

# Submission documents — kept local, not pushed to Git
Instruction_for_submission-DOCS/
Submission-DOC/

# Generated by the documentation build scripts
docs/__pycache__/

# Node.js / Landing Page
node_modules/
dist/
.env
.env.local
.env.*.local
*.tsbuildinfo

# ── Large local archives ───────────────────────────────────────────────
# landingPage.zip is 460MB — GitHub rejects files over 100MB and the push
# dies with "remote end hung up unexpectedly". Never commit archives.
*.zip

# ── Presentation / submission material — kept local ────────────────────
presentation/

# ── Credentials — never commit real values ─────────────────────────────
# Real keys belong in local.properties (ignored above), never in a
# tracked file. secrets.defaults.properties is a placeholder template
# and is intentionally still tracked.
secrets.properties
*.keystore
*.jks
google-services.json
